{
  "redirects": [
    {
      "source": "/kendall-dog-boarding.html",
      "destination": "/pinecrest-dog-boarding.html",
      "permanent": true
    },
    {
      "source": "/kendall-dog-boarding",
      "destination": "/pinecrest-dog-boarding.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/review",
      "destination": "/review.html"
    },
    {
      "source": "/reviews",
      "destination": "/review.html"
    },
    {
      "source": "/reviews-admin",
      "destination": "/reviews-admin.html"
    }
  ],
  "headers": [
    {
      "source": "/reviews-admin(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
